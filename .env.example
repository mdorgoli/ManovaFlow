POSTGRES_DB=manovaflow
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql://postgres:replace-with-a-long-random-local-password@127.0.0.1:55432/manovaflow
# Server-only role used by growth storage and membership lookup.
# Local isolated databases use their own restricted login here, not a shared cluster role.
DATABASE_APPLICATION_ROLE=manovaflow_app
IDENTITY_DATABASE_URL=postgresql://manovaflow_identity_login:replace-with-a-distinct-long-random-password@127.0.0.1:55432/manovaflow
TEST_DATABASE_URL=postgresql://postgres:replace-with-a-long-random-local-password@127.0.0.1:55432/manovaflow
DEMO_MODE=true
DEMO_TENANT_ID=10000000-0000-4000-8000-000000000001
DEMO_ACTOR_ID=20000000-0000-4000-8000-000000000001
DEMO_ACTOR_ROLE=OWNER

# Phase 2B production identity stays fail-closed until every value is supplied.
APP_ORIGIN=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_JSON=
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_MFA_AMR_VALUES=mfa,otp,hwk,swk
OIDC_MFA_ACR_VALUES=
OIDC_CLOCK_SKEW_SECONDS=30
OIDC_MAX_TOKEN_LIFETIME_SECONDS=3600
OIDC_MAX_MFA_AGE_SECONDS=600
SESSION_MAX_LIFETIME_SECONDS=900
SESSION_IDLE_TIMEOUT_SECONDS=300
AUTH_RATE_LIMIT_HMAC_KEY=
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
AUTH_RATE_LIMIT_BLOCK_SECONDS=60
IDENTITY_CLEANUP_RETENTION_SECONDS=604800
IDENTITY_CLEANUP_BATCH_SIZE=200
