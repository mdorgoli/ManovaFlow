{
  "name": "manovaflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:watch": "vitest --exclude tests/integration/**",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "identity:cleanup": "tsx scripts/cleanup-identity.ts",
    "demo": "tsx scripts/run-demo.ts",
    "pilot:market-scout": "tsx scripts/run-market-scout-pilot.ts",
    "lint": "node scripts/style.mjs lint",
    "format:verify": "node scripts/style.mjs format:verify",
    "format:check": "node scripts/style.mjs format:check",
    "format": "node scripts/style.mjs format",
    "lint:fix": "node scripts/style.mjs lint:fix",
    "check:style": "pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
